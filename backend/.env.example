# Backend Environment Variables
# Copy this file to .env and fill in values

PORT=5000
MONGODB_URI=mongodb://localhost:27017/rentbike
JWT_SECRET=your-64-char-hex-secret-here

# PII encryption — REQUIRED IN PRODUCTION.
# Without this, NID, driving licence, and phone number are stored in cleartext and
# the server refuses to start when NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Pepper for duplicate-detection hashes (nidHash / phoneHash). Optional; falls back
# to ENCRYPTION_KEY when unset. Rotating it invalidates existing hashes, so treat it
# as long-lived and back it up alongside ENCRYPTION_KEY.
PII_HASH_PEPPER=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SSLCommerz (sandbox)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_IS_LIVE=false

# URLs (local dev)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Preview deployments (comma-separated origins allowed through CORS).
# Set on Render to the frontend-next Vercel preview domain, e.g.
# PREVIEW_URLS=https://rent-bike-next.vercel.app
PREVIEW_URLS=
# IoT device auth for POST /api/tracking (ESP32 / GSM modules).
# Leave unset and the endpoint rejects every request.
IOT_API_KEY=

# Live vehicle positions require a session unless this is set to true.
# Enabling it publishes real-time locations — including a customer's vehicle while
# it is being ridden — to anonymous visitors.
TRACKING_PUBLIC=false

# Disable all background jobs (tests, local work on the scheduler itself)
DISABLE_JOBS=false
